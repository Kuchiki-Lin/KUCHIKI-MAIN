# =============================================================================
# KUCHIKI - Environment configuration template
# =============================================================================
#
# Copy this file to `.env.local` and fill in the values:
#
#     cp .env.example .env.local
#
# `.env.local` is gitignored (see .gitignore -> `.env*.local`). NEVER commit real
# credentials. This template must only ever contain placeholders.
#
# Full setup instructions: docs/DEVELOPMENT.md
# =============================================================================


# -----------------------------------------------------------------------------
# LOCAL DEVELOPMENT MODE
# -----------------------------------------------------------------------------
# Set to "true" to route Firebase Auth and Firestore at the local Firebase
# Emulator Suite instead of a real Firebase project. When true, the
# NEXT_PUBLIC_FIREBASE_* values below are not used for anything real and the
# placeholder values shipped in this template are sufficient.
#
# Requires a JDK 11+ on PATH (the Firestore emulator is a Java process) and
# `npm run emulators` running in another terminal. See docs/DEVELOPMENT.md.
#
# Leave unset or "false" to talk to a real Firebase project.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true


# -----------------------------------------------------------------------------
# FIREBASE - CLIENT SDK (public)
# -----------------------------------------------------------------------------
# These are NOT secrets. Firebase Web API keys are public identifiers by design
# and are compiled into the client bundle; the `NEXT_PUBLIC_` prefix makes that
# explicit. Your data is protected by firestore.rules, not by keeping these
# hidden. Find them in: Firebase console -> Project settings -> Your apps.
#
# The placeholder values below are good enough for emulator mode.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDUMMYDUMMYDUMMYDUMMYDUMMYDUMMY00
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-kuchiki.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-kuchiki
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-kuchiki.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000


# -----------------------------------------------------------------------------
# FIREBASE - ADMIN SDK (SECRET - server side only)
# -----------------------------------------------------------------------------
# A service account JSON key, as a single-line JSON string. This one IS a real
# secret: it grants full administrative access to the Firebase project and
# bypasses all security rules.
#
# Generate: Firebase console -> Project settings -> Service accounts
#           -> Generate new private key
#
# Used by app/firebaseAdmin.js to verify ID tokens on API routes.
# NOT required in emulator mode.
#
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}
FIREBASE_SERVICE_ACCOUNT_KEY=


# -----------------------------------------------------------------------------
# RESEND - transactional email (SECRET)
# -----------------------------------------------------------------------------
# Powers the four /api/* email routes. Leave blank for local development unless
# you are specifically working on email: the routes degrade to a clear 503 when
# it is missing rather than crashing.
#
# WARNING: with a real key present, these routes can send mail from your
# verified domain. Do not point local development at a production Resend key.
RESEND_API_KEY=

# Sender address. Must be on a domain verified in your Resend account.
EMAIL_FROM=noreply@example.com

# Internal recipient for staff notifications (new survey, research request,
# digitization request, pending-approval digest).
EMAIL_TO=staff@example.com


# -----------------------------------------------------------------------------
# CLOUDINARY - product testing image uploads (public)
# -----------------------------------------------------------------------------
# Product-testing images upload directly from the browser using an UNSIGNED
# upload preset, so both values are necessarily public.
#
# Harden the preset itself in the Cloudinary dashboard - restrict allowed
# formats, max file size and target folder. See docs/SECURITY-FINDINGS.md M2.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=


# -----------------------------------------------------------------------------
# DEPRECATED - do not use
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SECRETO was the "admin password" for /approvals/qanvas. Because of
# the NEXT_PUBLIC_ prefix it was compiled into the public client bundle, so it
# never protected anything. Superseded by real admin authentication via the
# Firebase Auth `admin` custom claim.
#
# See docs/SECURITY-FINDINGS.md C1. Remove once P1.1 has landed.
# NEXT_PUBLIC_SECRETO=
